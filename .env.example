# --- Servidor ---
PORT=8080
HOST=0.0.0.0
# Carpeta donde se guardan PDFs, estado y datos extraídos (volumen persistente).
DATA_DIR=./data

# --- Ciclo de actualización ---
# Cada cuántas horas se revisa la web de la EPI (por defecto 24).
REFRESH_HOURS=24
# Cada cuántos días se fuerza una descarga COMPLETA de todos los PDF para verificar su hash,
# aunque el tamaño (HEAD) no haya cambiado. 0 = nunca (confiar sólo en el tamaño).
FULL_VERIFY_DAYS=7
# Peticiones simultáneas a la web de la EPI (sé amable con su servidor).
SCRAPE_CONCURRENCY=3

# --- Origen ---
EPI_BASE_URL=https://epigijon.uniovi.es

# --- Motor Python (extracción de PDF y Excel) ---
# Intérprete con pandas, pdfplumber, openpyxl... (ver engine/requirements.txt).
PYTHON_BIN=./engine/.venv/bin/python

# --- Administración ---
# Token para POST /api/admin/refresh. Si está vacío, el endpoint queda desactivado.
ADMIN_TOKEN=
